<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="JSEARCH_FILTER_SEARCH_LABEL"
            description="JSEARCH_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER_SEARCH_LABEL"
        />

        <field
            name="published"
            type="status"
            label="JOPTION_SELECT_PUBLISHED"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="*">JALL</option>
        </field>

        <field
            name="municipio_id"
            type="sql"
            label="COM_HORARIOS_FIELD_MUNICIPIO_LABEL"
            query="SELECT id AS value, title AS text FROM #__horarios_municipios ORDER BY title ASC"
            key_field="value"
            value_field="text"
            onchange="this.form.submit();"
        >
            <option value="">COM_HORARIOS_FILTER_ALL_MUNICIPIOS</option>
        </field>

        <field
            name="tipo"
            type="list"
            label="COM_HORARIOS_FIELD_TIPO_LABEL"
            onchange="this.form.submit();"
        >
            <option value="">JALL</option>
            <option value="circuito">COM_HORARIOS_TIPO_CIRCUITO</option>
            <option value="localidade">COM_HORARIOS_TIPO_LOCALIDADE</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.ordering ASC"
            onchange="this.form.submit();"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
            <option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
            <option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="a.state ASC">JGRID_HEADING_PUBLISHED_ASC</option>
            <option value="a.state DESC">JGRID_HEADING_PUBLISHED_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="20"
            onchange="this.form.submit();"
        />
    </fields>
</form>
