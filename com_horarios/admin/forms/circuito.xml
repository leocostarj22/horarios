<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details" label="COM_HORARIOS_FIELDSET_DETAILS">
        <field
            name="id"
            type="number"
            class="readonly"
            label="JGLOBAL_FIELD_ID_LABEL"
            default="0"
            readonly="true"
        />

        <field
            name="municipio_id"
            type="sql"
            label="COM_HORARIOS_FIELD_MUNICIPIO_LABEL"
            query="SELECT id AS value, title AS text FROM #__horarios_municipios WHERE state IN (0,1) ORDER BY title ASC"
            key_field="value"
            value_field="text"
            required="true"
        >
            <option value="">JGLOBAL_SELECT_AN_OPTION</option>
        </field>

        <field
            name="parent_id"
            type="sql"
            label="COM_HORARIOS_FIELD_PARENT_LABEL"
            description="COM_HORARIOS_FIELD_PARENT_DESC"
            query="SELECT id AS value, title AS text FROM #__horarios_circuitos WHERE parent_id = 0 ORDER BY title ASC"
            key_field="value"
            value_field="text"
            default="0"
        >
            <option value="0">COM_HORARIOS_FIELD_PARENT_NONE</option>
        </field>

        <field
            name="title"
            type="text"
            label="COM_HORARIOS_FIELD_TITLE_LABEL"
            size="40"
            required="true"
        />

        <field
            name="alias"
            type="text"
            label="COM_HORARIOS_FIELD_ALIAS_LABEL"
            hint="COM_HORARIOS_FIELD_ALIAS_HINT"
            size="40"
        />

        <field
            name="folheto_file"
            type="media"
            label="COM_HORARIOS_FIELD_FOLHETO_LABEL"
            description="COM_HORARIOS_FIELD_FOLHETO_DESC"
            preview="true"
            types="images,documents"
        />

        <field
            name="circuito_file"
            type="media"
            label="COM_HORARIOS_FIELD_CIRCUITO_FILE_LABEL"
            description="COM_HORARIOS_FIELD_CIRCUITO_FILE_DESC"
            preview="true"
            types="images,documents"
        />

        <field
            name="horario_file"
            type="media"
            label="COM_HORARIOS_FIELD_HORARIO_FILE_LABEL"
            description="COM_HORARIOS_FIELD_HORARIO_FILE_DESC"
            preview="true"
            types="images,documents"
        />

        <field
            name="tarifario_file"
            type="media"
            label="COM_HORARIOS_FIELD_TARIFARIO_FILE_LABEL"
            description="COM_HORARIOS_FIELD_TARIFARIO_FILE_DESC"
            preview="true"
            types="images,documents"
        />

        <field
            name="ordering"
            type="hidden"
        />

        <field
            name="state"
            type="list"
            label="JSTATUS"
            default="1"
            filter="intval"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
    </fieldset>

    <fieldset name="jmetadata" label="JGLOBAL_FIELDSET_PUBLISHING">
        <field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" />
        <field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" />
        <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" translateformat="true" showtime="true" filter="user_utc" readonly="true" />
        <field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" readonly="true" />
    </fieldset>
</form>
